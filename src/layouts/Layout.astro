<style is:global>
  :root {
    /* Brand Colors */
    --tftr-green: #5CB85C;
    --tftr-green-dark: #4a9a4a;
    --tftr-green-light: #7dcc7d;
    --tftr-black: #0a0a0a;
    --tftr-dark: #111111;
    --tftr-darker: #1a1a1a;
    --tftr-white: #ffffff;
    --tftr-grey: #888888;
    --tftr-grey-light: #cccccc;
    
    /* Typography */
    --font-display: 'Bebas Neue', sans-serif;
    --font-heading: 'Barlow Condensed', sans-serif;
    --font-body: 'Barlow', sans-serif;
    
    /* Spacing */
    --space-xs: 0.5rem;
    --space-sm: 1rem;
    --space-md: 2rem;
    --space-lg: 4rem;
    --space-xl: 6rem;
    
    /* Container */
    --container-max: 1400px;
    --container-padding: 1.5rem;
  }

  *, *::before, *::after {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  html {
    scroll-behavior: smooth;
  }

  body {
    font-family: var(--font-body);
    font-size: 16px;
    line-height: 1.6;
    color: var(--tftr-white);
    background-color: var(--tftr-black);
    -webkit-font-smoothing: antialiased;
  }

  h1, h2, h3, h4, h5, h6 {
    font-family: var(--font-heading);
    font-weight: 600;
    line-height: 1.1;
    text-transform: uppercase;
    letter-spacing: 0.02em;
  }

  h1 {
    font-family: var(--font-display);
    font-size: clamp(3rem, 8vw, 6rem);
    letter-spacing: 0.05em;
  }

  h2 {
    font-size: clamp(2rem, 5vw, 3.5rem);
  }

  h3 {
    font-size: clamp(1.5rem, 3vw, 2rem);
  }

  p {
    max-width: 65ch;
  }

  a {
    color: inherit;
    text-decoration: none;
    transition: color 0.2s ease;
  }

  a:hover {
    color: var(--tftr-green);
  }

  img {
    max-width: 100%;
    height: auto;
  }

  ul {
    list-style: none;
  }

  .container {
    max-width: var(--container-max);
    margin: 0 auto;
    padding: 0 var(--container-padding);
  }

  /* Button Styles */
  .btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 1rem 2rem;
    font-family: var(--font-heading);
    font-size: 1.1rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    border: none;
    cursor: pointer;
    transition: all 0.3s ease;
  }

  .btn-primary {
    background: var(--tftr-green);
    color: var(--tftr-black);
  }

  .btn-primary:hover {
    background: var(--tftr-green-light);
    color: var(--tftr-black);
    transform: translateY(-2px);
  }

  .btn-outline {
    background: transparent;
    color: var(--tftr-white);
    border: 2px solid var(--tftr-green);
  }

  .btn-outline:hover {
    background: var(--tftr-green);
    color: var(--tftr-black);
  }

  /* Green accent text */
  .text-green {
    color: var(--tftr-green);
  }

  /* Section spacing */
  section {
    padding: var(--space-xl) 0;
  }

  /* Racing stripe decoration */
  .stripe-accent {
    display: inline-block;
    width: 60px;
    height: 4px;
    background: var(--tftr-green);
    margin-bottom: var(--space-sm);
  }
</style>


