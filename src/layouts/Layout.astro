---
interface Props {
  title: string;
  description?: string;
}

const { title, description = "Bespoke Nitron and Penske suspension specification, chassis development and vehicle dynamics consultancy from Too Fast To Race. Over 30 years of motorsport and suspension development experience." } = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/png" href="/images/TFTR_Icon.png" />
    <title>{title} | Too Fast To Race</title>

    <link rel="canonical" href={Astro.url} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Too Fast To Race" />
    <meta property="og:title" content={`${title} | Too Fast To Race`} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="https://toofasttorace.com/images/TFTR.png" />
    <meta property="og:url" content={Astro.url} />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={`${title} | Too Fast To Race`} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content="https://toofasttorace.com/images/TFTR.png" />

    <!-- Structured Data -->
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "LocalBusiness",
      "name": "Too Fast To Race",
      "alternateName": "TFTR",
      "legalName": "S Rogers Engineering Ltd",
      "description": "Specialist suspension specification, chassis development and vehicle dynamics consultancy. Bespoke Nitron and Penske suspension systems for fast road, track day and motorsport applications.",
      "url": "https://toofasttorace.com",
      "logo": "https://toofasttorace.com/images/TFTR.png",
      "image": "https://toofasttorace.com/images/TFTR.png",
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "Y Gwernen",
        "addressLocality": "Dryslwyn",
        "addressRegion": "Carmarthen",
        "postalCode": "SA32 8SA",
        "addressCountry": "GB"
      },
      "geo": {
        "@type": "GeoCoordinates",
        "latitude": "51.8566",
        "longitude": "-4.0731"
      },
      "areaServed": "United Kingdom",
      "serviceType": [
        "Suspension Specification",
        "Chassis Development",
        "Vehicle Dynamics Consultancy",
        "Nitron Suspension Systems",
        "Penske Racing Shocks",
        "Track Day Suspension Setup",
        "Hillclimb Suspension"
      ],
      "knowsAbout": [
        "Suspension Engineering",
        "Vehicle Dynamics",
        "Nitron Suspension",
        "Penske Racing Shocks",
        "Caterham Seven",
        "Caterham 7",
        "Lotus Seven",
        "Lotus 7",
        "Chassis Development",
        "Motorsport Engineering"
      ],
      "sameAs": []
    }
    </script>
    
    <!-- Google Fonts - Racing-inspired typography -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Barlow:wght@400;500;600;700&family=Barlow+Condensed:wght@400;500;600;700&display=swap" rel="stylesheet">
  </head>
  <body>
    <header class="site-header">
      <nav class="nav-container">
        <a href="/" class="logo">
          <img src="/images/TFTR_Icon.png" alt="Too Fast To Race" class="logo-img" />
        </a>
        <button class="mobile-menu-btn" aria-label="Toggle menu">
          <span></span>
          <span></span>
          <span></span>
        </button>
        <ul class="nav-links">
          <li><a href="/">Home</a></li>
          <li class="dropdown">
            <a href="/suspension">Suspension <span class="dropdown-arrow">▼</span></a>
            <ul class="dropdown-menu">
              <li><a href="/nitron-suspension">Nitron Systems</a></li>
              <li><a href="/penske-racing-shocks">Penske Racing Shocks</a></li>
              <li><a href="/nitron-electron">Nitron elec-TRON</a></li>
              <li><a href="/nitron-r1-vs-r3">R1 vs R3 Explained</a></li>
            </ul>
          </li>
          <li class="dropdown">
            <a href="/services">Applications <span class="dropdown-arrow">▼</span></a>
            <ul class="dropdown-menu">
              <li><a href="/fast-road-suspension">Fast Road</a></li>
              <li><a href="/track-day-suspension">Track Day</a></li>
              <li><a href="/nurburgring-suspension">Nürburgring</a></li>
              <li><a href="/hillclimb-suspension">Hillclimb</a></li>
            </ul>
          </li>
          <li class="dropdown">
            <a href="#">Vehicles <span class="dropdown-arrow">▼</span></a>
            <ul class="dropdown-menu">
              <li><a href="/caterham">Caterham</a></li>
              <li><a href="/porsche-suspension">Porsche</a></li>
              <li><a href="/lotus-suspension">Lotus</a></li>
              <li><a href="/bmw-suspension">BMW</a></li>
              <li><a href="/mazda-mx5-suspension">Mazda MX-5</a></li>
              <li><a href="/alpine-suspension">Alpine A110</a></li>
              <li><a href="/toyota-gr-yaris-suspension">Toyota GR Yaris</a></li>
              <li><a href="/tvr-suspension">TVR</a></li>
            </ul>
          </li>
          <li><a href="/about">Philosophy</a></li>
          <li><a href="/partners">Partners</a></li>
          <li><a href="/contact" class="nav-cta">Discuss Your Car</a></li>
        </ul>
      </nav>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <div class="footer-content">
        <div class="footer-brand">
          <img src="/images/TFTR_Icon.png" alt="TFTR" class="footer-logo" />
          <p class="footer-tagline">Too Fast To Race</p>
          <p class="footer-company">S Rogers Engineering Ltd</p>
          <div class="footer-caterham-links">
            <a href="/caterham">Caterham</a>
            <a href="/kawasaki-h2-parts">Kawasaki H2 Parts</a>
          </div>
        </div>
        <div class="footer-contact">
          <h4>Location</h4>
          <address>
            Y Gwernen<br />
            Dryslwyn<br />
            Carmarthen<br />
            SA32 8SA
          </address>
        </div>
        <div class="footer-links">
          <h4>Suspension</h4>
          <ul>
            <li><a href="/suspension">Suspension Overview</a></li>
            <li><a href="/nitron-suspension">Nitron Systems</a></li>
            <li><a href="/penske-racing-shocks">Penske Racing Shocks</a></li>
            <li><a href="/nitron-electron">Nitron elec-TRON</a></li>
            <li><a href="/track-day-suspension">Track Day</a></li>
            <li><a href="/fast-road-suspension">Fast Road</a></li>
            <li><a href="/nurburgring-suspension">Nürburgring</a></li>
            <li><a href="/hillclimb-suspension">Hillclimb</a></li>
          </ul>
        </div>
        <div class="footer-links">
          <h4>Vehicles</h4>
          <ul>
            <li><a href="/caterham">Caterham</a></li>
            <li><a href="/lotus-suspension">Lotus</a></li>
            <li><a href="/porsche-suspension">Porsche</a></li>
            <li><a href="/bmw-suspension">BMW</a></li>
            <li><a href="/mazda-mx5-suspension">Mazda MX-5</a></li>
            <li><a href="/toyota-gr-yaris-suspension">Toyota GR Yaris</a></li>
            <li><a href="/alpine-suspension">Alpine A110</a></li>
            <li><a href="/tvr-suspension">TVR</a></li>
          </ul>
        </div>
        <div class="footer-partners">
          <h4>Partners</h4>
          <ul>
            <li>Penske Racing Shocks</li>
            <li>Nitron Racing Systems</li>
            <li>Hyperco Springs</li>
            <li>Eibach</li>
          </ul>
        </div>
      </div>
      <div class="footer-bottom">
        <p>&copy; {new Date().getFullYear()} S Rogers Engineering Ltd. All rights reserved.</p>
      </div>
    </footer>

    <script>
      // Mobile menu toggle
      const menuBtn = document.querySelector('.mobile-menu-btn');
      const navLinks = document.querySelector('.nav-links');
      
      menuBtn?.addEventListener('click', () => {
        navLinks?.classList.toggle('active');
        menuBtn.classList.toggle('active');
      });

      // Mobile dropdown toggles
      function initMobileDropdowns() {
        if (window.innerWidth <= 900) {
          const dropdowns = document.querySelectorAll('.dropdown');
          dropdowns.forEach(dropdown => {
            const link = dropdown.querySelector('a');
            if (link && !link.hasAttribute('data-mobile-handler')) {
              link.setAttribute('data-mobile-handler', 'true');
              link.addEventListener('click', (e) => {
                e.preventDefault();
                dropdown.classList.toggle('dropdown-open');
              });
            }
          });
        }
      }

      // Run on load and resize
      initMobileDropdowns();
      window.addEventListener('resize', initMobileDropdowns);
    </script>
  </body>
</html>

<style is:global>
  :root {
    /* Brand Colors */
    --tftr-green: #5CB85C;
    --tftr-green-dark: #4a9a4a;
    --tftr-green-light: #7dcc7d;
    --tftr-black: #0a0a0a;
    --tftr-dark: #111111;
    --tftr-darker: #1a1a1a;
    --tftr-white: #ffffff;
    --tftr-grey: #888888;
    --tftr-grey-light: #cccccc;
    
    /* Typography */
    --font-display: 'Bebas Neue', sans-serif;
    --font-heading: 'Barlow Condensed', sans-serif;
    --font-body: 'Barlow', sans-serif;
    
    /* Spacing */
    --space-xs: 0.5rem;
    --space-sm: 1rem;
    --space-md: 2rem;
    --space-lg: 4rem;
    --space-xl: 6rem;
    
    /* Container */
    --container-max: 1400px;
    --container-padding: 1.5rem;
  }

  *, *::before, *::after {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  html {
    scroll-behavior: smooth;
  }

  body {
    font-family: var(--font-body);
    font-size: 16px;
    line-height: 1.6;
    color: var(--tftr-white);
    background-color: var(--tftr-black);
    -webkit-font-smoothing: antialiased;
  }

  h1, h2, h3, h4, h5, h6 {
    font-family: var(--font-heading);
    font-weight: 600;
    line-height: 1.1;
    text-transform: uppercase;
    letter-spacing: 0.02em;
  }

  h1 {
    font-family: var(--font-display);
    font-size: clamp(3rem, 8vw, 6rem);
    letter-spacing: 0.05em;
  }

  h2 {
    font-size: clamp(2rem, 5vw, 3.5rem);
  }

  h3 {
    font-size: clamp(1.5rem, 3vw, 2rem);
  }

  p {
    max-width: 65ch;
  }

  a {
    color: inherit;
    text-decoration: none;
    transition: color 0.2s ease;
  }

  a:hover {
    color: var(--tftr-green);
  }

  img {
    max-width: 100%;
    height: auto;
  }

  ul {
    list-style: none;
  }

  .container {
    max-width: var(--container-max);
    margin: 0 auto;
    padding: 0 var(--container-padding);
  }

  /* Button Styles */
  .btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 1rem 2rem;
    font-family: var(--font-heading);
    font-size: 1.1rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    border: none;
    cursor: pointer;
    transition: all 0.3s ease;
  }

  .btn-primary {
    background: var(--tftr-green);
    color: var(--tftr-black);
  }

  .btn-primary:hover {
    background: var(--tftr-green-light);
    color: var(--tftr-black);
    transform: translateY(-2px);
  }

  .btn-outline {
    background: transparent;
    color: var(--tftr-white);
    border: 2px solid var(--tftr-green);
  }

  .btn-outline:hover {
    background: var(--tftr-green);
    color: var(--tftr-black);
  }

  /* Green accent text */
  .text-green {
    color: var(--tftr-green);
  }

  /* Section spacing */
  section {
    padding: var(--space-xl) 0;
  }

  /* Racing stripe decoration */
  .stripe-accent {
    display: inline-block;
    width: 60px;
    height: 4px;
    background: var(--tftr-green);
    margin-bottom: var(--space-sm);
  }
</style>


