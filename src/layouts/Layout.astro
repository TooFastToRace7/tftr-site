---
interface Props {
  title: string;
  description?: string;
}

const { title, description = "Bespoke Nitron and Penske suspension specification, chassis development and vehicle dynamics consultancy from Too Fast To Race. Over 30 years of motorsport and suspension development experience." } = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/png" href="/images/TFTR_Icon.png" />
    <title>{title} | Too Fast To Race</title>

    <link rel="canonical" href={Astro.url} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Too Fast To Race" />
    <meta property="og:title" content={`${title} | Too Fast To Race`} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="https://toofasttorace.com/images/TFTR.png" />
    <meta property="og:url" content={Astro.url} />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={`${title} | Too Fast To Race`} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content="https://toofasttorace.com/images/TFTR.png" />

    <!-- Structured Data -->
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "LocalBusiness",
      "name": "Too Fast To Race",
      "alternateName": "TFTR",
      "legalName": "S Rogers Engineering Ltd",
      "description": "Specialist suspension specification, chassis development and vehicle dynamics consultancy. Bespoke Nitron and Penske suspension systems for fast road, track day and motorsport applications.",
      "url": "https://toofasttorace.com",
      "logo": "https://toofasttorace.com/images/TFTR.png",
      "image": "https://toofasttorace.com/images/TFTR.png",
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "Y Gwernen",
        "addressLocality": "Dryslwyn",
        "addressRegion": "Carmarthen",
        "postalCode": "SA32 8SA",
        "addressCountry": "GB"
      },
      "geo": {
        "@type": "GeoCoordinates",
        "latitude": "51.8566",
        "longitude": "-4.0731"
      },
      "areaServed": "United Kingdom",
      "serviceType": [
        "Suspension Specification",
        "Chassis Development",
        "Vehicle Dynamics Consultancy",
        "Nitron Suspension Systems",
        "Penske Racing Shocks",
        "Track Day Suspension Setup",
        "Hillclimb Suspension"
      ],
      "knowsAbout": [
        "Suspension Engineering",
        "Vehicle Dynamics",
        "Nitron Suspension",
        "Penske Racing Shocks",
        "Caterham Seven",
        "Caterham 7",
        "Lotus Seven",
        "Lotus 7",
        "Chassis Development",
        "Motorsport Engineering"
      ],
      "sameAs": []
    }
    </script>
    
    <!-- Google Fonts - Racing-inspired typography -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Barlow:wght@400;500;600;700&family=Barlow+Condensed:wght@400;500;600;700&display=swap" rel="stylesheet">
  </head>
  <body>
    <header class="site-header">
      <nav class="nav-container">
        <a href="/" class="logo">
          <img src="/images/TFTR_Icon.png" alt="Too Fast To Race" class="logo-img" onerror="this.src='/images/TFTR.png'" />
        </a>
        <button class="mobile-menu-btn" aria-label="Toggle menu">
          <span></span>
          <span></span>
          <span></span>
        </button>
        <ul class="nav-links">
          <li><a href="/">Home</a></li>
          <li class="dropdown">
            <a href="/suspension">Suspension <span class="dropdown-arrow">▼</span></a>
            <ul class="dropdown-menu">
              <li><a href="/nitron-suspension">Nitron Systems</a></li>
              <li><a href="/penske-racing-shocks">Penske Racing Shocks</a></li>
              <li><a href="/nitron-electron">Nitron elec-TRON</a></li>
              <li><a href="/nitron-r1-vs-r3">R1 vs R3 Explained</a></li>
            </ul>
          </li>
          <li class="dropdown">
            <a href="/services">Applications <span class="dropdown-arrow">▼</span></a>
            <ul class="dropdown-menu">
              <li><a href="/fast-road-suspension">Fast Road</a></li>
              <li><a href="/track-day-suspension">Track Day</a></li>
              <li><a href="/nurburgring-suspension">Nürburgring</a></li>
              <li><a href="/hillclimb-suspension">Hillclimb</a></li>
            </ul>
          </li>
          <li class="dropdown">
            <a href="#">Vehicles <span class="dropdown-arrow">▼</span></a>
            <ul class="dropdown-menu">
              <li><a href="/caterham">Caterham</a></li>
              <li><a href="/porsche-suspension">Porsche</a></li>
              <li><a href="/lotus-suspension">Lotus</a></li>
              <li><a href="/bmw-suspension">BMW</a></li>
              <li><a href="/mazda-mx5-suspension">Mazda MX-5</a></li>
              <li><a href="/alpine-suspension">Alpine A110</a></li>
              <li><a href="/toyota-gr-yaris-suspension">Toyota GR Yaris</a></li>
              <li><a href="/tvr-suspension">TVR</a></li>
            </ul>
          </li>
          <li><a href="/about">Philosophy</a></li>
          <li><a href="/partners">Partners</a></li>
          <li><a href="/contact" class="nav-cta">Discuss Your Car</a></li>
        </ul>
      </nav>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <div class="footer-content">
        <div class="footer-brand">
          <img src="/images/TFTR_Icon.png" alt="TFTR" class="footer-logo" />
          <p class="footer-tagline">Too Fast To Race</p>
          <p class="footer-company">S Rogers Engineering Ltd</p>
          <div class="footer-caterham-links">
            <a href="/caterham">Caterham</a>
            <a href="/kawasaki-h2-parts">Kawasaki H2 Parts</a>
          </div>
        </div>
        <div class="footer-contact">
          <h4>Location</h4>
          <address>
            Y Gwernen<br />
            Dryslwyn<br />
            Carmarthen<br />
            SA32 8SA
          </address>
        </div>
        <div class="footer-links">
          <h4>Suspension</h4>
          <ul>
            <li><a href="/suspension">Suspension Overview</a></li>
            <li><a href="/nitron-suspension">Nitron Systems</a></li>
            <li><a href="/penske-racing-shocks">Penske Racing Shocks</a></li>
            <li><a href="/nitron-electron">Nitron elec-TRON</a></li>
            <li><a href="/track-day-suspension">Track Day</a></li>
            <li><a href="/fast-road-suspension">Fast Road</a></li>
            <li><a href="/nurburgring-suspension">Nürburgring</a></li>
            <li><a href="/hillclimb-suspension">Hillclimb</a></li>
          </ul>
        </div>
        <div class="footer-links">
          <h4>Vehicles</h4>
          <ul>
            <li><a href="/caterham">Caterham</a></li>
            <li><a href="/lotus-suspension">Lotus</a></li>
            <li><a href="/porsche-suspension">Porsche</a></li>
            <li><a href="/bmw-suspension">BMW</a></li>
            <li><a href="/mazda-mx5-suspension">Mazda MX-5</a></li>
            <li><a href="/toyota-gr-yaris-suspension">Toyota GR Yaris</a></li>
            <li><a href="/alpine-suspension">Alpine A110</a></li>
            <li><a href="/tvr-suspension">TVR</a></li>
          </ul>
        </div>
        <div class="footer-partners">
          <h4>Partners</h4>
          <ul>
            <li>Penske Racing Shocks</li>
            <li>Nitron Racing Systems</li>
            <li>Hyperco Springs</li>
            <li>Eibach</li>
          </ul>
        </div>
      </div>
      <div class="footer-bottom">
        <p>&copy; {new Date().getFullYear()} S Rogers Engineering Ltd. All rights reserved.</p>
      </div>
    </footer>

    <script>
      // Mobile menu toggle
      const menuBtn = document.querySelector('.mobile-menu-btn');
      const navLinks = document.querySelector('.nav-links');
      
      menuBtn?.addEventListener('click', () => {
        navLinks?.classList.toggle('active');
        menuBtn.classList.toggle('active');
      });

      // Mobile dropdown toggles
      function initMobileDropdowns() {
        if (window.innerWidth <= 900) {
          const dropdowns = document.querySelectorAll('.dropdown');
          dropdowns.forEach(dropdown => {
            const link = dropdown.querySelector('a');
            if (link && !link.hasAttribute('data-mobile-handler')) {
              link.setAttribute('data-mobile-handler', 'true');
              link.addEventListener('click', (e) => {
                e.preventDefault();
                dropdown.classList.toggle('dropdown-open');
              });
            }
          });
        }
      }

      // Run on load and resize
      initMobileDropdowns();
      window.addEventListener('resize', initMobileDropdowns);
    </script>
  </body>
</html>

<style is:global>
  :root {
    /* Brand Colors */
    --tftr-green: #5CB85C;
    --tftr-green-dark: #4a9a4a;
    --tftr-green-light: #7dcc7d;
    --tftr-black: #0a0a0a;
    --tftr-dark: #111111;
    --tftr-darker: #1a1a1a;
    --tftr-white: #ffffff;
    --tftr-grey: #888888;
    --tftr-grey-light: #cccccc;
    
    /* Typography */
    --font-display: 'Bebas Neue', sans-serif;
    --font-heading: 'Barlow Condensed', sans-serif;
    --font-body: 'Barlow', sans-serif;
    
    /* Spacing */
    --space-xs: 0.5rem;
    --space-sm: 1rem;
    --space-md: 2rem;
    --space-lg: 4rem;
    --space-xl: 6rem;
    
    /* Container */
    --container-max: 1400px;
    --container-padding: 1.5rem;
  }

  *, *::before, *::after {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  html {
    scroll-behavior: smooth;
  }

  body {
    font-family: var(--font-body);
    font-size: 16px;
    line-height: 1.6;
    color: var(--tftr-white);
    background-color: var(--tftr-black);
    -webkit-font-smoothing: antialiased;
  }

  h1, h2, h3, h4, h5, h6 {
    font-family: var(--font-heading);
    font-weight: 600;
    line-height: 1.1;
    text-transform: uppercase;
    letter-spacing: 0.02em;
  }

  h1 {
    font-family: var(--font-display);
    font-size: clamp(3rem, 8vw, 6rem);
    letter-spacing: 0.05em;
  }

  h2 {
    font-size: clamp(2rem, 5vw, 3.5rem);
  }

  h3 {
    font-size: clamp(1.5rem, 3vw, 2rem);
  }

  p {
    max-width: 65ch;
  }

  a {
    color: inherit;
    text-decoration: none;
    transition: color 0.2s ease;
  }

  a:hover {
    color: var(--tftr-green);
  }

  img {
    max-width: 100%;
    height: auto;
  }

  ul {
    list-style: none;
  }

  .container {
    max-width: var(--container-max);
    margin: 0 auto;
    padding: 0 var(--container-padding);
  }

  /* Button Styles */
  .btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 1rem 2rem;
    font-family: var(--font-heading);
    font-size: 1.1rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    border: none;
    cursor: pointer;
    transition: all 0.3s ease;
  }

  .btn-primary {
    background: var(--tftr-green);
    color: var(--tftr-black);
  }

  .btn-primary:hover {
    background: var(--tftr-green-light);
    color: var(--tftr-black);
    transform: translateY(-2px);
  }

  .btn-outline {
    background: transparent;
    color: var(--tftr-white);
    border: 2px solid var(--tftr-green);
  }

  .btn-outline:hover {
    background: var(--tftr-green);
    color: var(--tftr-black);
  }

  /* Green accent text */
  .text-green {
    color: var(--tftr-green);
  }

  /* Section spacing */
  section {
    padding: var(--space-xl) 0;
  }

  /* Racing stripe decoration */
  .stripe-accent {
    display: inline-block;
    width: 60px;
    height: 4px;
    background: var(--tftr-green);
    margin-bottom: var(--space-sm);
  }
  /* Header */
  .site-header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 1000;
    background: rgba(10, 10, 10, 0.95);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid rgba(92, 184, 92, 0.2);
  }

  .nav-container {
    max-width: var(--container-max);
    margin: 0 auto;
    padding: 0.5rem var(--container-padding);
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 80px;
  }

  .logo-img {
    height: 50px;
    width: auto;
    margin-top: 0;
    margin-bottom: 0;
  }

  .nav-links {
    display: flex;
    align-items: center;
    gap: 2rem;
  }

  .nav-links a {
    font-family: var(--font-heading);
    font-size: 1rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    padding: 0.5rem 0;
    position: relative;
  }

  /* Dropdown styling */
  .dropdown {
    position: relative;
  }

  .dropdown-arrow {
    font-size: 0.7rem;
    margin-left: 0.25rem;
  }

  .dropdown-menu {
    position: absolute;
    top: 100%;
    left: 0;
    background: var(--tftr-darker);
    border: 1px solid rgba(92, 184, 92, 0.3);
    min-width: 200px;
    padding: 0.5rem 0;
    opacity: 0;
    visibility: hidden;
    transition: all 0.2s ease;
    z-index: 1000;
    list-style: none;
  }

  .dropdown:hover .dropdown-menu {
    opacity: 1;
    visibility: visible;
  }

  .dropdown-menu li {
    margin: 0;
  }

  .dropdown-menu a {
    display: block;
    padding: 0.5rem 1.5rem;
    white-space: nowrap;
    font-size: 0.9rem;
  }

  .dropdown-menu a::after {
    display: none;
  }

  .dropdown-menu a:hover {
    background: rgba(92, 184, 92, 0.1);
    color: var(--tftr-green);
  }

  .nav-links a::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    width: 0;
    height: 2px;
    background: var(--tftr-green);
    transition: width 0.3s ease;
  }

  .nav-links a:hover::after {
    width: 100%;
  }

  .nav-cta {
    background: var(--tftr-green);
    color: var(--tftr-black) !important;
    padding: 0.75rem 1.5rem !important;
    font-weight: 600;
  }

  .nav-cta:hover {
    background: var(--tftr-green-light);
  }

  .nav-cta::after {
    display: none;
  }

  /* Mobile Menu Button */
  .mobile-menu-btn {
    display: none;
    flex-direction: column;
    gap: 5px;
    background: none;
    border: none;
    cursor: pointer;
    padding: 0.5rem;
    z-index: 1001;
  }

  .mobile-menu-btn span {
    display: block;
    width: 25px;
    height: 2px;
    background: var(--tftr-white);
    transition: all 0.3s ease;
  }

  .mobile-menu-btn.active span:nth-child(1) {
    transform: rotate(45deg) translate(5px, 5px);
  }

  .mobile-menu-btn.active span:nth-child(2) {
    opacity: 0;
  }

  .mobile-menu-btn.active span:nth-child(3) {
    transform: rotate(-45deg) translate(5px, -5px);
  }

  /* Footer */
  .site-footer {
    background: var(--tftr-darker);
    border-top: 1px solid rgba(92, 184, 92, 0.2);
    padding: var(--space-lg) 0 var(--space-md);
  }

  .footer-content {
    max-width: var(--container-max);
    margin: 0 auto;
    padding: 0 var(--container-padding);
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: var(--space-lg);
  }

  .footer-brand {
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
  }

  .footer-logo {
    width: 60px;
    height: auto;
    margin-bottom: var(--space-xs);
  }

  .footer-tagline {
    font-family: var(--font-display);
    font-size: 1.5rem;
    letter-spacing: 0.1em;
  }

  .footer-company {
    color: var(--tftr-grey);
    font-size: 0.9rem;
  }

  .footer-caterham-links {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    margin-top: var(--space-sm);
  }

  .footer-caterham-links a {
    color: var(--tftr-grey-light);
    font-size: 0.95rem;
  }

  .footer-caterham-links a:hover {
    color: var(--tftr-green);
  }

  .footer-content h4 {
    font-family: var(--font-heading);
    font-size: 1rem;
    color: var(--tftr-green);
    margin-bottom: var(--space-sm);
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }

  .footer-contact address {
    font-style: normal;
    color: var(--tftr-grey-light);
    line-height: 1.8;
  }

  .footer-links ul,
  .footer-partners ul {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .footer-links a,
  .footer-partners li {
    color: var(--tftr-grey-light);
    font-size: 0.95rem;
  }

  .footer-links a:hover {
    color: var(--tftr-green);
  }

  .footer-bottom {
    max-width: var(--container-max);
    margin: var(--space-lg) auto 0;
    padding: var(--space-md) var(--container-padding) 0;
    border-top: 1px solid rgba(255, 255, 255, 0.1);
    text-align: center;
    color: var(--tftr-grey);
    font-size: 0.85rem;
  }

  /* Responsive */
  @media (max-width: 900px) {
    .mobile-menu-btn {
      display: flex;
    }

    .nav-links {
      position: fixed;
      top: 0;
      right: -100%;
      width: 100%;
      height: 100vh;
      background: var(--tftr-black);
      flex-direction: column;
      justify-content: center;
      gap: 2rem;
      transition: right 0.3s ease;
      overflow-y: auto;
      padding: 2rem;
    }

    .nav-links.active {
      right: 0;
    }

    .nav-links a {
      font-size: 1.5rem;
    }

    /* Mobile dropdowns */
    .dropdown {
      width: 100%;
      text-align: center;
    }

    .dropdown-menu {
      position: static;
      opacity: 1;
      visibility: visible;
      display: none;
      background: var(--tftr-darker);
      border: none;
      padding-left: 1rem;
      margin-top: 0.5rem;
    }

    .dropdown.dropdown-open .dropdown-menu {
      display: block;
    }

    .dropdown-arrow {
      display: inline-block;
      transition: transform 0.2s ease;
    }

    .dropdown.dropdown-open .dropdown-arrow {
      transform: rotate(180deg);
    }
  }
</style>


