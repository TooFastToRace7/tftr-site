---
import Layout from '../layouts/Layout.astro';
import AuthorPanel from '../components/AuthorPanel.astro';

// NOTE: prices are Nitron UK retail list prices, ex VAT (price list November 2026).
// One page covers several kits, so `offers` is an AggregateOffer.
const structuredData = {
  "@context": "https://schema.org",
  "@type": "Product",
  "name": "Nitron Coilover Kits for the Porsche Cayman and Boxster",
  "description": "Nitron coilover suspension kits for the Porsche Boxster and Cayman 986, 987, 981 and 718, including the GT4 and GT4 RS. Nitron's standard specification at list price, or spring rates and valving specified for your car by Simon Rogers.",
  "brand": {
    "@type": "Brand",
    "name": "Nitron Racing Systems"
  },
  "category": "Coilover Suspension Kit",
  "image": "https://toofasttorace.com/images/nitron/NTCPO030R1.jpg",
  "url": "https://toofasttorace.com/porsche-cayman-boxster-nitron-kits/",
  "offers": {
    "@type": "AggregateOffer",
    "url": "https://toofasttorace.com/porsche-cayman-boxster-nitron-kits/",
    "priceCurrency": "GBP",
    "lowPrice": "3440.00",
    "highPrice": "7265.00",
    "offerCount": "19",
    "availability": "https://schema.org/PreOrder",
    "seller": {
      "@type": "Organization",
      "name": "Too Fast To Race"
    }
  }
};
---

<Layout title="Porsche Cayman &amp; Boxster Nitron Coilover Kits | Prices | Too Fast To Race" description="Nitron coilover kits for the Porsche Boxster and Cayman 986, 987, 981 and 718, including the GT4 and GT4 RS. From £3,440 +VAT. Nitron's standard specification, or spring rates and valving specified for your car by Simon Rogers.">
  <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />

  <!-- Hero -->
  <section class="page-hero">
    <div class="container">
      <span class="stripe-accent"></span>
      <h1>Porsche Cayman &amp; Boxster <span class="text-green">Nitron Kits</span></h1>
      <div class="hero-intro">
        <div class="brand-logo-chip">
          <img src="/images/Nitron.png" alt="Nitron coilover kits for the Porsche Cayman and Boxster — Nitron Racing Systems" class="brand-logo" width="160" height="64" />
        </div>
        <p class="hero-subtitle">Nitron coilover kits for the Porsche Boxster and Cayman 986, 987, 981 and 718, including the GT4 and GT4 RS. Buy the kit to Nitron's standard specification at list price, or have the spring rates and valving specified for your car, your tyres and the way you use it.</p>
      </div>
    </div>
  </section>

  <!-- Summary / Price -->
  <section class="kit-summary-section">
    <div class="container">
      <div class="kit-summary">
        <div class="kit-price">
          <span class="price-label">From</span>
          <span class="price-figure">£3,440</span>
          <span class="price-note">+ VAT &amp; shipping</span>
        </div>
        <div class="kit-specs">
          <div class="spec">
            <span class="spec-label">Cars</span>
            <span class="spec-value">986 · 987 · 981 · 718</span>
          </div>
          <div class="spec">
            <span class="spec-label">Kits</span>
            <span class="spec-value">R1 · R3 · RS3 · elec-TRON</span>
          </div>
          <div class="spec">
            <span class="spec-label">Prices</span>
            <span class="spec-value">Nitron UK retail, ex VAT</span>
          </div>
          <div class="spec">
            <span class="spec-label">Supply</span>
            <span class="spec-value">Made to order</span>
          </div>
        </div>
        <a href="/contact/" class="btn btn-primary">Enquire About These Kits</a>
      </div>
    </div>
  </section>

  <!-- Kits and prices -->
