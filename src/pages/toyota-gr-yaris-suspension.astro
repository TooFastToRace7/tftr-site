  }

  .characteristic-card h3 {
    font-size: 1.2rem;
    color: var(--tftr-green);
    margin-bottom: var(--space-sm);
  }

  .characteristic-card p {
    color: var(--tftr-grey-light);
    font-size: 0.95rem;
    line-height: 1.7;
    margin-bottom: var(--space-sm);
  }

  /* Spec Section */
  .spec-section {
    background: var(--tftr-black);
  }

  .spec-grid {
    display: grid;
