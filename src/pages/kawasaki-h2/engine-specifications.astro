    border-bottom: 1px solid rgba(92, 184, 92, 0.2);
  }

  .hero-subtitle {
    font-size: 1.25rem;
    color: var(--tftr-grey-light);
    max-width: 65ch;
    margin-top: var(--space-sm);
    line-height: 1.7;
  }

  /* Shared */
  .section-header {
    margin-bottom: var(--space-lg);
  }

  .section-header p {
    color: var(--tftr-grey-light);
    margin-top: var(--space-xs);
    max-width: 70ch;
  }

  .kit-card-brand {
    display: block;
    font-family: var(--font-heading);
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    color: var(--tftr-green);
    margin-bottom: 0.25rem;
  }

  /* Synopsis */
  .synopsis-section {
    background: var(--tftr-black);
  }

  .synopsis-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-xl);
    align-items: start;
  }

  .synopsis-block h3 {
    font-size: 1.35rem;
    color: var(--tftr-white);
    margin-bottom: var(--space-sm);
  }

  .synopsis-block h3 + p {
    margin-top: 0;
  }

  .synopsis-block > h3:not(:first-child) {
    margin-top: var(--space-lg);
  }

  .synopsis-block p {
    color: var(--tftr-grey-light);
    line-height: 1.8;
    margin-bottom: var(--space-sm);
  }

  .synopsis-block p strong {
    color: var(--tftr-white);
  }

  .synopsis-block a {
    color: var(--tftr-green);
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .spec-table {
    background: var(--tftr-dark);
    border: 1px solid rgba(255, 255, 255, 0.05);
    margin: var(--space-md) 0;
  }

  .spec-row {
    display: grid;
    grid-template-columns: 1.6fr 1fr 1fr;
    gap: var(--space-sm);
    padding: 0.7rem var(--space-sm);
    border-bottom: 1px solid rgba(255, 255, 255, 0.05);
    font-size: 0.9rem;
    color: var(--tftr-grey-light);
  }

  .spec-row:last-child {
    border-bottom: none;
  }

  .spec-row-head {
    font-family: var(--font-heading);
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--tftr-green);
    background: rgba(92, 184, 92, 0.08);
  }

  /* Measured Output */
  .dyno-section {
    background: var(--tftr-darker);
    border-bottom: 1px solid rgba(92, 184, 92, 0.2);
  }

  .dyno-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-md);
    align-items: start;
  }

  .dyno-figure {
    margin: 0;
    background: var(--tftr-dark);
    border: 1px solid rgba(255, 255, 255, 0.05);
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }

  .dyno-image {
    background: var(--tftr-white);
    padding: var(--space-sm);
  }

  .dyno-image img {
    width: 100%;
    height: auto;
    display: block;
  }

  .dyno-figure figcaption {
    padding: var(--space-md);
  }

  .dyno-figure figcaption p {
    color: var(--tftr-grey-light);
    font-size: 0.95rem;
    line-height: 1.7;
    margin: 0;
  }

  .dyno-figure figcaption p strong {
    color: var(--tftr-white);
  }

  .dyno-notes {
    margin-top: var(--space-lg);
    max-width: 75ch;
  }

  .dyno-notes p {
    color: var(--tftr-grey-light);
    line-height: 1.8;
    margin-bottom: var(--space-sm);
  }

  .dyno-notes a {
    color: var(--tftr-green);
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .dyno-notes p:last-child {
    color: var(--tftr-grey);
    font-size: 0.85rem;
    margin-bottom: 0;
  }

  /* Reference Download */
  .reference-section {
    background: var(--tftr-black);
  }

