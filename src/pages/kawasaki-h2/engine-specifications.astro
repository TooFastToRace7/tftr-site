    margin-bottom: var(--space-xs);
  }

  .expertise-header p {
    color: var(--tftr-grey-light);
    max-width: 55ch;
    margin: 0 auto;
  }

  .expertise-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--space-md);
  }

  .expertise-link {
    display: block;
    padding: var(--space-sm) var(--space-md);
    background: var(--tftr-dark);
    border: 1px solid rgba(255, 255, 255, 0.05);
    text-align: center;
    font-family: var(--font-heading);
    font-size: 0.9rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    transition: all 0.3s ease;
  }

  .expertise-link:hover {
    border-color: var(--tftr-green);
    background: rgba(92, 184, 92, 0.1);
    transform: translateY(-2px);
  }

  /* CTA */
  .cta-section {
    background: linear-gradient(135deg, var(--tftr-green-dark), var(--tftr-green));
    text-align: center;
  }

  .cta-content h2 {
    color: var(--tftr-black);
  }

  .cta-content p {
    color: rgba(0, 0, 0, 0.7);
    font-size: 1.25rem;
    margin: var(--space-sm) auto var(--space-md);
    max-width: 55ch;
  }

  .cta-content .btn-primary {
    background: var(--tftr-black);
    color: var(--tftr-white);
  }

  .cta-content .btn-primary:hover {
    background: var(--tftr-darker);
  }

  /* Responsive */
  @media (max-width: 900px) {
    .synopsis-grid {
      grid-template-columns: 1fr;
      gap: var(--space-lg);
    }

    .dyno-grid {
      grid-template-columns: 1fr;
    }

    .expertise-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 600px) {
    .spec-row {
      grid-template-columns: 1.4fr 0.8fr 0.8fr;
      font-size: 0.82rem;
    }

    .reference-block {
      padding: var(--space-md);
    }
  }
</style>
