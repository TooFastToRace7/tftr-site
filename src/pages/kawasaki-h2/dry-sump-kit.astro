  /* Responsive */
  @media (max-width: 900px) {
    .kit-summary {
      grid-template-columns: 1fr;
      gap: var(--space-md);
    }

    .kit-specs {
      grid-template-columns: repeat(2, 1fr);
    }

    .related-grid {
      grid-template-columns: 1fr;
    }

    .included-grid {
      grid-template-columns: 1fr;
    }

    .showcase-grid {
      grid-template-columns: 1fr;
      gap: var(--space-md);
    }
  }
</style>