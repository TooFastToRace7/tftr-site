    flex-direction: column;
  }

  .related-card:hover {
    border-color: rgba(92, 184, 92, 0.3);
    transform: translateY(-4px);
  }

  .related-card h3 {
    font-size: 1.25rem;
    margin-bottom: var(--space-sm);
    color: var(--tftr-white);
  }

  .related-card p {
