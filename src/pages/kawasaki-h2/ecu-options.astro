const structuredData = {
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": "Kawasaki H2 Standalone ECU Options & Engine Management",
  "description": "What a standalone ECU must handle on a supercharged Kawasaki H2 in a car — immobiliser removal, ride-by-wire throttle, trigger interpretation and boost strategy.",
  "url": "https://toofasttorace.com/kawasaki-h2/ecu-options",
  "author": {
    "@type": "Person",
    "name": "Simon Rogers"
  },
  "publisher": {
    "@type": "Organization",
    "name": "Too Fast To Race"
  }
