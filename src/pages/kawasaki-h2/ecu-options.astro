    margin-bottom: var(--space-lg);
  }

  .factor-card {
    background: var(--tftr-darker);
    padding: var(--space-md);
    border: 1px solid rgba(255, 255, 255, 0.05);
    border-top: 2px solid var(--tftr-green);
  }

  .factor-num {
    display: block;
    font-family: var(--font-display);
    font-size: 2rem;
