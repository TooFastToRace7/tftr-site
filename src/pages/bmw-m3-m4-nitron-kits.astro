---
import Layout from '../layouts/Layout.astro';
import AuthorPanel from '../components/AuthorPanel.astro';

// NOTE: prices are Nitron UK retail list prices, ex VAT (price list November 2026).
// One page covers several kits, so `offers` is an AggregateOffer.
const structuredData = {
  "@context": "https://schema.org",
  "@type": "Product",
  "name": "Nitron Coilover Kits for the BMW M3 and M4",
  "description": "Nitron coilover suspension kits for the BMW M3 and M4: E46, E90, E92, F80, F82, G80 and G82. Nitron's standard specification at list price, or spring rates and valving specified for your car by Simon Rogers.",
  "brand": {
    "@type": "Brand",
    "name": "Nitron Racing Systems"
  },
  "category": "Coilover Suspension Kit",
  "image": "https://toofasttorace.com/images/nitron/NTCBM011R1.jpg",
  "url": "https://toofasttorace.com/bmw-m3-m4-nitron-kits/",
  "offers": {
    "@type": "AggregateOffer",
    "url": "https://toofasttorace.com/bmw-m3-m4-nitron-kits/",
    "priceCurrency": "GBP",
    "lowPrice": "2290.00",
    "highPrice": "9040.00",
    "offerCount": "50",
    "availability": "https://schema.org/PreOrder",
    "seller": {
      "@type": "Organization",
      "name": "Too Fast To Race"
    }
  }
};
---

<Layout title="BMW M3 &amp; M4 Nitron Coilover Kits | Prices | Too Fast To Race" description="Nitron coilover kits for the BMW M3 and M4: E46, E90, E92, F80, F82, G80 and G82. From £2,290 +VAT. Nitron's standard specification, or spring rates and valving specified for your car by Simon Rogers.">
  <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />

  <!-- Hero -->
  <section class="page-hero">
    <div class="container">
      <span class="stripe-accent"></span>
      <h1>BMW M3 &amp; M4 <span class="text-green">Nitron Kits</span></h1>
      <div class="hero-intro">
        <div class="brand-logo-chip">
          <img src="/images/Nitron.png" alt="Nitron coilover kits for the BMW M3 and M4 — Nitron Racing Systems" class="brand-logo" width="160" height="64" />
        </div>
        <p class="hero-subtitle">Nitron coilover kits for the BMW M3 and M4: E46, E90, E92, F80, F82, G80 and G82. Buy the kit to Nitron's standard specification at list price, or have the spring rates and valving specified for your car, your tyres and the way you use it.</p>
      </div>
    </div>
  </section>

  <!-- Summary / Price -->
  <section class="kit-summary-section">
    <div class="container">
      <div class="kit-summary">
        <div class="kit-price">
          <span class="price-label">From</span>
          <span class="price-figure">£2,290</span>
          <span class="price-note">+ VAT &amp; shipping</span>
        </div>
        <div class="kit-specs">
          <div class="spec">
            <span class="spec-label">Cars</span>
            <span class="spec-value">E46 · E9x · F8x · G8x</span>
          </div>
          <div class="spec">
            <span class="spec-label">Kits</span>
            <span class="spec-value">RoadSport · R1 · R3 · elec-TRON</span>
          </div>
          <div class="spec">
            <span class="spec-label">Prices</span>
            <span class="spec-value">Nitron UK retail, ex VAT</span>
          </div>
          <div class="spec">
            <span class="spec-label">Supply</span>
            <span class="spec-value">Made to order</span>
          </div>
        </div>
        <a href="/contact/" class="btn btn-primary">Enquire About These Kits</a>
      </div>
    </div>
  </section>

  <!-- Kits and prices -->
  <section class="kit-content">
    <div class="container">
      <div class="content-block">
        <h2>Kits and <span class="text-green">Prices</span></h2>
        <p>Every kit is a four-corner coilover kit, supplied complete and ready to fit with springs. Prices are Nitron's UK retail prices, excluding VAT and shipping. Spring rates are Nitron's standard rates in lb/in, front then rear.</p>
      </div>

