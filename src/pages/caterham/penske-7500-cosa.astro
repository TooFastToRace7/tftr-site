---
import Layout from '../../layouts/Layout.astro';

const structuredData = {
  "@context": "https://schema.org",
  "@type": "Product",
  "name": "Caterham Penske 7500 COSA Suspension Kit",
  "description": "Penske 7500 COSA single-adjustable coilover suspension kit for the Caterham Seven — S3, SV and CSR chassis. Sweep or clicker rebound adjuster. Front digressive/linear and rear linear pistons, built on Simon Rogers' championship-winning valving. Supplied with Eibach springs and mounting spacers.",
  "brand": {
    "@type": "Brand",
    "name": "Penske Racing Shocks"
  },
  "category": "Coilover Suspension Kit",
  "image": "https://toofasttorace.com/images/Penske.png",
  "url": "https://toofasttorace.com/caterham/penske-7500-cosa",
  "offers": {
    "@type": "Offer",
    "url": "https://toofasttorace.com/caterham/penske-7500-cosa",
    "priceCurrency": "GBP",
    "price": "3392.00",
    "availability": "https://schema.org/InStock",
    "seller": {
      "@type": "Organization",
      "name": "Too Fast To Race"
    }
  }
};
---

<Layout title="Caterham Penske 7500 COSA Suspension Kit | S3 SV CSR | Too Fast To Race" description="Penske 7500 COSA single-adjustable coilover suspension kit for the Caterham Seven — S3, SV and CSR. Sweep or clicker adjuster. From £3,392 +VAT. Eibach springs, mounting spacers and Simon Rogers' championship-winning valving. Bespoke specification from Too Fast To Race.">
  <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />

  <!-- Hero -->
  <section class="page-hero">
    <div class="container">
      <span class="stripe-accent"></span>
      <h1>Caterham Penske <span class="text-green">7500 COSA</span></h1>
      <div class="hero-intro">
        <div class="brand-logo-chip">
          <img src="/images/Penske.png" alt="Penske 7500 COSA suspension for Caterham — Penske Racing Shocks" class="brand-logo" width="160" height="64" />
        </div>
        <p class="hero-subtitle">The single-adjustable entry to genuine Penske ownership for the Caterham Seven. The same engineering trusted at the highest levels of motorsport, valved specifically for the Seven and built to be rebuilt and developed for the life of the car.</p>
      </div>
    </div>
  </section>

  <!-- Summary / Price -->
  <section class="kit-summary-section">
    <div class="container">
      <div class="kit-summary">
        <div class="kit-price">
          <span class="price-label">From</span>
          <span class="price-figure">£3,392</span>
          <span class="price-note">+ VAT &amp; shipping · clicker from £3,636</span>
        </div>
        <div class="kit-specs">
          <div class="spec">
            <span class="spec-label">Damper</span>
            <span class="spec-value">Penske 7500 COSA</span>
          </div>
          <div class="spec">
            <span class="spec-label">Adjustment</span>
            <span class="spec-value">Single-Adjustable</span>
          </div>
          <div class="spec">
            <span class="spec-label">Springs</span>
            <span class="spec-value">Eibach (Hyperco optional)</span>
          </div>
          <div class="spec">
            <span class="spec-label">Chassis</span>
            <span class="spec-value">S3 · SV · CSR</span>
          </div>
        </div>
        <a href="/contact" class="btn btn-primary">Enquire About This Kit</a>
      </div>
    </div>
  </section>

  <!-- What It Is -->
  <section class="kit-content">
    <div class="container">
      <div class="showcase-grid">
        <div class="showcase-image">
          <img src="/images/7500.png" alt="Penske 7500 COSA single-adjustable coilover damper for Caterham Seven — S3, SV and CSR" width="800" height="900" loading="lazy" />
        </div>
        <div class="content-block showcase-text">
          <h2>Penske Engineering for the <span class="text-green">Caterham Seven</span></h2>
          <p>The Penske 7500 COSA is the single-adjustable coilover in Penske's 7500 range — the same manufacturing precision, consistency and full rebuildability that Penske is trusted for across global motorsport, specified here for the Caterham Seven. A single external adjuster lets you fine-tune the car around a base that has already been valved correctly for the application.</p>
          <p>Every 7500 COSA kit we supply is built on Simon Rogers' championship-winning valving — developed and proven over years of real Caterham competition, not copied from a catalogue. The front dampers run digressive/linear pistons and the rear run a linear piston, a configuration chosen deliberately for how the Seven loads each axle.</p>
        </div>
      </div>

      <div class="content-block">
        <h2>Sweep or Clicker <span class="text-green">Adjuster</span></h2>
        <p>The 7500 COSA is offered with two rebound adjuster styles. The standard <strong>sweep adjuster</strong> — the type shown in the images — is set with a pin tool and is the proven, robust choice for most cars, from <strong>£3,392</strong>. The <strong>clicker eyelet</strong> offers quicker, more repeatable adjustment by hand and is the option many competition drivers prefer, from <strong>£3,636</strong>. The kit is otherwise identical — the choice is purely the adjuster. Both prices are +VAT and shipping.</p>
      </div>

      <div class="content-block">
        <h2>Who the 7500 COSA is <span class="text-green">For</span></h2>
        <p>This is the right kit for the committed Caterham driver who wants genuine Penske build quality and the ability to rebuild and re-valve as the car develops over time — <a href="/track-day-suspension">serious track day</a> and club competition use where that long-term engineering investment makes sense.</p>
        <p>For many <a href="/fast-road-suspension">fast road</a> and lighter track day Caterhams, a correctly specified <a href="/caterham/nitron-ntr-r1">Nitron NTR R1</a> will deliver outstanding performance for considerably less, and we will always tell you so honestly. If you want more adjustment within the Penske range, the double-adjustable <a href="/caterham/penske-7500-coda">7500 CODA</a> and the triple-adjustable <a href="/caterham/penske-8700-3-way">8700 3-way</a> step up from here. Our wider view on the brand is on the <a href="/penske-racing-shocks">Penske Racing Shocks</a> page.</p>
      </div>

      <!-- Included / Options -->
      <div class="included-grid">
        <div class="included-col">
          <h3>What's Included</h3>
          <ul class="kit-list">
            <li>Four-corner Penske 7500 COSA single-adjustable coilover kit</li>
            <li>Eibach springs</li>
            <li>Mounting spacers</li>
            <li>Simon Rogers' championship-winning valving — front digressive/linear, rear linear</li>
            <li>Specified for your chassis, tyres and application</li>
          </ul>
        </div>
        <div class="included-col">
          <h3>Options</h3>
          <ul class="kit-list">
            <li>Clicker eyelet adjuster in place of the standard sweep adjuster (from £3,636)</li>
            <li>Hyperco springs in place of the standard Eibach springs</li>
            <li>Hydraulic spring perches for quick ride-height adjustment</li>
            <li>Torrington bearings to reduce friction during ride-height adjustment</li>
          </ul>
        </div>
      </div>

      <div class="content-block">
        <h2>Caterham <span class="text-green">Fitment</span></h2>
        <p>This kit is specified for the Caterham Seven across the S3, SV and CSR chassis. The price is the same for each — the specification work behind it is what adapts the kit to your particular car. If you are unsure which chassis you have or how your car is used, tell us and we will guide you.</p>
      </div>
    </div>
  </section>

  <!-- Related -->
  <section class="related-section">
    <div class="container">
      <div class="section-header">
        <span class="stripe-accent"></span>
        <h2>Related Expertise</h2>
      </div>
      <div class="related-grid">
        <a href="/caterham/penske-7500-coda" class="related-card">
          <h3>Penske 7500 CODA</h3>
          <p>Double-adjustable — independent compression and rebound from the same 7500 platform.</p>
          <span class="related-link">View the CODA →</span>
        </a>
        <a href="/caterham/penske-8700-3-way" class="related-card">
          <h3>Penske 8700 3-Way</h3>
          <p>Triple-adjustable with remote canister — the top of the Caterham Penske range.</p>
          <span class="related-link">View the 8700 →</span>
        </a>
        <a href="/penske-racing-shocks" class="related-card">
          <h3>Penske Racing Shocks</h3>
          <p>Why Penske is the benchmark in motorsport — and when it is and isn't the right answer.</p>
          <span class="related-link">Penske →</span>
        </a>
        <a href="/caterham/nitron-ntr-r1" class="related-card">
          <h3>Nitron NTR R1 40mm</h3>
          <p>The value answer for most road and track day Caterhams — and why we often recommend it.</p>
          <span class="related-link">View the R1 →</span>
        </a>
        <a href="/caterham/suspension" class="related-card">
          <h3>Caterham Suspension Kits</h3>
          <p>The full range of Caterham coilover kits — Nitron and Penske — in one place.</p>
          <span class="related-link">All Kits →</span>
        </a>
        <a href="/track-day-suspension" class="related-card">
          <h3>Track Day Suspension</h3>
          <p>What track day use actually demands, and why balance matters more than stiffness.</p>
          <span class="related-link">Track Day →</span>
        </a>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="cta-section">
    <div class="container">
      <div class="cta-content">
        <h2>Specify Your 7500 COSA Kit</h2>
        <p>Tell us about your Caterham, your tyres and how you use the car. We will specify a 7500 COSA kit built on proven valving — and give you an honest answer if a Nitron system suits you better.</p>
        <a href="/contact" class="btn btn-primary">Start Your Specification</a>
      </div>
    </div>
  </section>

</Layout>

<style>
  /* Page Hero */
  .page-hero {
    padding: calc(80px + var(--space-xl)) 0 var(--space-lg);
    background: var(--tftr-darker);
    border-bottom: 1px solid rgba(92, 184, 92, 0.2);
  }

  .hero-subtitle {
    font-size: 1.25rem;
    color: var(--tftr-grey-light);
    max-width: 65ch;
    margin-top: var(--space-sm);
    line-height: 1.7;
  }

  .hero-intro {
    display: flex;
    align-items: stretch;
    gap: var(--space-md);
    margin-top: var(--space-md);
  }

  .hero-intro .hero-subtitle {
    margin-top: 0;
  }

  .brand-logo-chip {
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--tftr-white);
    padding: 0.6rem 1rem;
    border-radius: 4px;
    flex-shrink: 0;
  }

  .brand-logo {
    height: 100%;
    width: auto;
    max-height: 96px;
    display: block;
  }

  @media (max-width: 600px) {
    .hero-intro {
      flex-direction: column;
      align-items: flex-start;
    }

    .brand-logo {
      height: 44px;
    }
  }

  /* Summary / Price */
  .kit-summary-section {
    background: var(--tftr-black);
    padding: var(--space-lg) 0;
  }

  .kit-summary {
    display: grid;
    grid-template-columns: auto 1fr auto;
    gap: var(--space-lg);
    align-items: center;
    background: var(--tftr-darker);
    border: 1px solid rgba(92, 184, 92, 0.2);
    border-left: 3px solid var(--tftr-green);
    padding: var(--space-md);
  }

  .kit-price {
    display: flex;
    flex-direction: column;
    line-height: 1.1;
  }

  .price-label {
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--tftr-grey);
  }

  .price-figure {
    font-family: var(--font-display);
    font-size: 3rem;
    color: var(--tftr-green);
    letter-spacing: 0.03em;
  }

  .price-note {
    font-size: 0.8rem;
    color: var(--tftr-grey);
  }

  .kit-specs {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--space-sm);
  }

  .spec {
    display: flex;
    flex-direction: column;
  }

  .spec-label {
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--tftr-grey);
  }

  .spec-value {
    font-family: var(--font-heading);
    font-size: 1.05rem;
    color: var(--tftr-white);
  }

  /* Content */
  .kit-content {
    background: var(--tftr-black);
  }

  .content-block {
    max-width: 800px;
    margin-bottom: var(--space-lg);
  }

  .content-block h2 {
    margin-bottom: var(--space-md);
  }

  .content-block p {
    color: var(--tftr-grey-light);
    font-size: 1.05rem;
    line-height: 1.8;
    margin-bottom: var(--space-sm);
  }

  .included-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-md);
    margin-bottom: var(--space-lg);
  }

  .included-col {
    background: var(--tftr-darker);
    padding: var(--space-md);
    border: 1px solid rgba(255, 255, 255, 0.05);
    border-top: 2px solid var(--tftr-green);
  }

  .included-col h3 {
    font-size: 1.1rem;
    color: var(--tftr-green);
    margin-bottom: var(--space-sm);
  }

  .kit-list {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .kit-list li {
    position: relative;
    padding-left: 1.25rem;
    color: var(--tftr-grey-light);
    font-size: 0.95rem;
    line-height: 1.5;
  }

  .kit-list li::before {
    content: '→';
    position: absolute;
    left: 0;
    color: var(--tftr-green);
  }

  /* Related */
  .related-section {
    background: var(--tftr-darker);
  }

  .section-header {
    margin-bottom: var(--space-lg);
  }

  .related-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-md);
  }

  .related-card {
    background: var(--tftr-dark);
    padding: var(--space-md);
    border: 1px solid rgba(255, 255, 255, 0.05);
    transition: all 0.3s ease;
    display: flex;
    flex-direction: column;
  }

  .related-card:hover {
    border-color: rgba(92, 184, 92, 0.3);
    transform: translateY(-4px);
  }

  .related-card h3 {
    font-size: 1.25rem;
    margin-bottom: var(--space-sm);
    color: var(--tftr-white);
  }

  .related-card p {
    color: var(--tftr-grey-light);
    font-size: 0.95rem;
    line-height: 1.6;
    flex-grow: 1;
    margin-bottom: var(--space-sm);
  }

  .related-link {
    font-family: var(--font-heading);
    font-size: 0.85rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--tftr-green);
    margin-top: auto;
  }

  /* CTA */
  .cta-section {
    background: linear-gradient(135deg, var(--tftr-green-dark), var(--tftr-green));
    text-align: center;
  }

  .cta-content h2 {
    color: var(--tftr-black);
  }

  .cta-content p {
    color: rgba(0, 0, 0, 0.7);
    font-size: 1.25rem;
    margin: var(--space-sm) auto var(--space-md);
    max-width: 55ch;
  }

  .cta-content .btn-primary {
    background: var(--tftr-black);
    color: var(--tftr-white);
  }

  .cta-content .btn-primary:hover {
    background: var(--tftr-darker);
  }

  /* Responsive */
  @media (max-width: 900px) {
    .kit-summary {
      grid-template-columns: 1fr;
      gap: var(--space-md);
    }

    .kit-specs {
      grid-template-columns: repeat(2, 1fr);
    }

    .related-grid {
      grid-template-columns: 1fr;
    }
  }

  /* Product Showcase */
  .showcase-grid {
    display: grid;
    grid-template-columns: 0.85fr 1fr;
    gap: var(--space-xl);
    align-items: center;
    margin-bottom: var(--space-lg);
  }

  .showcase-image {
    background: var(--tftr-white);
    border-radius: 6px;
    padding: var(--space-md);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .showcase-image img {
    width: 100%;
    height: auto;
    max-height: 460px;
    object-fit: contain;
    display: block;
  }

  .showcase-text {
    margin-bottom: 0 !important;
  }

  @media (max-width: 900px) {
    .showcase-grid {
      grid-template-columns: 1fr;
      gap: var(--space-md);
    }
  }
</style>