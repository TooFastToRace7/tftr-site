    border-top: 1px solid rgba(92, 184, 92, 0.3);
  }

  .spec-table tr:last-child {
    border-bottom: 1px solid rgba(92, 184, 92, 0.3);
  }

  .spec-name {
    font-family: var(--font-heading);
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--tftr-grey);
    padding: var(--space-sm) var(--space-md) var(--space-sm) 0;
    white-space: nowrap;
    width: 220px;
  }

  .spec-detail {
    color: var(--tftr-grey-light);
    padding: var(--space-sm) 0;
    line-height: 1.6;
  }

  .spec-table tr:hover .spec-detail,
  .spec-table tr:hover .spec-name {
    color: var(--tftr-white);
  }

  /* How We Specify */
  .specify-section {
    background: var(--tftr-darker);
    padding: var(--space-xl) 0;
  }

  .specify-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-xl);
    align-items: start;
  }

  .specify-content .lead {
    font-family: var(--font-display);
    font-size: 1.75rem;
    color: var(--tftr-green);
    letter-spacing: 0.05em;
    margin-bottom: var(--space-md);
  }

  .specify-content p {
    color: var(--tftr-grey-light);
    line-height: 1.8;
    margin-bottom: var(--space-sm);
  }

  .specify-content .btn-primary {
    margin-top: var(--space-sm);
    display: inline-block;
  }

  .specify-steps {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
  }

  .step {
    display: flex;
    gap: var(--space-md);
    align-items: flex-start;
  }

  .step-num {
    font-family: var(--font-display);
    font-size: 2.5rem;
    color: var(--tftr-green);
    line-height: 1;
    min-width: 2rem;
  }

  .step-content h4 {
    font-family: var(--font-heading);
