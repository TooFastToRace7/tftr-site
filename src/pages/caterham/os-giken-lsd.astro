    border: 1px solid rgba(255, 255, 255, 0.05);
    padding: var(--space-md);
    transition: border-color 0.3s ease;
  }

  .tech-card:hover {
    border-color: rgba(92, 184, 92, 0.3);
  }

  .tech-card-header {
    display: flex;
    align-items: baseline;
    gap: var(--space-sm);
    margin-bottom: var(--space-sm);
  }

  .tech-number {
    font-family: var(--font-display);
    font-size: 2.5rem;
    color: var(--tftr-green);
    opacity: 0.5;
    line-height: 1;
  }

  .tech-card h3 {
    font-family: var(--font-heading);
    font-size: 1.3rem;
    color: var(--tftr-white);
  }

  .tech-card p {
    color: var(--tftr-grey-light);
    font-size: 0.95rem;
    line-height: 1.8;
    margin-bottom: var(--space-sm);
  }

  .tech-card ul {
    margin: var(--space-sm) 0;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .tech-card li {
    position: relative;
    padding-left: 1rem;
    color: var(--tftr-grey-light);
    font-size: 0.9rem;
