---
import Layout from '../../layouts/Layout.astro';

const structuredData = {
  "@context": "https://schema.org",
  "@type": "Product",
  "name": "Caterham Penske 8700 3-Way Suspension Kit",
  "description": "Penske 8700 3-way triple-adjustable coilover suspension kit with remote canister for the Caterham Seven — S3, SV and CSR chassis. Independent high-speed compression, low-speed compression and rebound adjustment. Front and rear digressive/linear pistons, built on Simon Rogers' championship-winning valving. Supplied with Eibach springs and mounting spacers.",
  "brand": {
    "@type": "Brand",
    "name": "Penske Racing Shocks"
  },
  "category": "Coilover Suspension Kit",
  "image": "https://toofasttorace.com/images/Penske.png",
  "url": "https://toofasttorace.com/caterham/penske-8700-3-way",
  "offers": {
    "@type": "Offer",
    "url": "https://toofasttorace.com/caterham/penske-8700-3-way",
    "priceCurrency": "GBP",
    "price": "7156.00",
    "availability": "https://schema.org/InStock",
    "seller": {
      "@type": "Organization",
      "name": "Too Fast To Race"
    },
    "shippingDetails": {
      "@type": "OfferShippingDetails",
      "shippingRate": {
        "@type": "MonetaryAmount",
        "value": "15.00",
        "currency": "GBP"
      },
      "shippingDestination": {
        "@type": "DefinedRegion",
        "addressCountry": "GB"
      }
    },
    "hasMerchantReturnPolicy": {
      "@type": "MerchantReturnPolicy",
      "applicableCountry": "GB",
      "returnPolicyCategory": "https://schema.org/MerchantReturnNotPermitted"
    }
  }
};
---

<Layout title="Caterham Penske 8700 3-Way Suspension Kit | S3 SV CSR | Too Fast To Race" description="Penske 8700 3-way triple-adjustable coilover suspension kit with remote canister for the Caterham Seven — S3, SV and CSR. High- and low-speed compression plus rebound. From £7,156 +VAT. Eibach springs, mounting spacers and Simon Rogers' championship-winning valving. Bespoke specification from Too Fast To Race.">
  <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />

  <!-- Hero -->
  <section class="page-hero">
    <div class="container">
      <span class="stripe-accent"></span>
      <h1>Caterham Penske <span class="text-green">8700 3-Way</span></h1>
      <div class="hero-intro">
        <div class="brand-logo-chip">
          <img src="/images/Penske.png" alt="Penske 8700 3-way suspension for Caterham — Penske Racing Shocks" class="brand-logo" width="160" height="64" />
        </div>
        <p class="hero-subtitle">The top of the Caterham Penske range. Triple-adjustable, remote-canister dampers with genuinely independent high-speed compression, low-speed compression and rebound control — the same architecture used at the highest levels of professional motorsport.</p>
      </div>
    </div>
  </section>

  <!-- Summary / Price -->
  <section class="kit-summary-section">
    <div class="container">
      <div class="kit-summary">
        <div class="kit-price">
          <span class="price-label">From</span>
          <span class="price-figure">£7,156</span>
          <span class="price-note">+ VAT &amp; shipping</span>
        </div>
        <div class="kit-specs">
          <div class="spec">
            <span class="spec-label">Damper</span>
            <span class="spec-value">Penske 8700 3-Way</span>
          </div>
          <div class="spec">
            <span class="spec-label">Adjustment</span>
            <span class="spec-value">Triple-Adjustable</span>
          </div>
          <div class="spec">
            <span class="spec-label">Springs</span>
            <span class="spec-value">Eibach (Hyperco optional)</span>
          </div>
          <div class="spec">
            <span class="spec-label">Chassis</span>
            <span class="spec-value">S3 · SV · CSR</span>
          </div>
        </div>
        <a href="/contact" class="btn btn-primary">Enquire About This Kit</a>
      </div>
    </div>
  </section>

  <!-- What It Is -->
  <section class="kit-content">
    <div class="container">
      <div class="showcase-grid">
        <div class="showcase-image">
          <img src="/images/8700.png" alt="Penske 8700 3-way triple-adjustable remote-canister coilover damper for Caterham Seven — S3, SV and CSR" width="800" height="900" loading="lazy" />
        </div>
        <div class="content-block showcase-text">
          <h2>The Benchmark, Built for the <span class="text-green">Seven</span></h2>
          <p>The Penske 8700 3-way is the most capable damper in the Caterham range we offer — a triple-adjustable, remote-canister coilover that separates high-speed compression, low-speed compression and rebound into three independent adjustments. It is the same architecture trusted across professional motorsport, valved specifically for the Caterham Seven.</p>
          <p>Every 8700 kit is built on Simon Rogers' championship-winning valving, proven in real competition. Both the front and rear dampers run digressive/linear pistons — a deliberate choice for a dedicated programme where the full breadth of the three-way adjustment is going to be used purposefully across both axles.</p>
        </div>
      </div>

      <div class="content-block">
        <h2>Three-Way <span class="text-green">Adjustment</span></h2>
        <p>The remote canister is what makes genuine high-speed compression control possible — separating it from low-speed compression so you can manage how the damper responds to sharp surface inputs independently of how it controls body movement. On the Caterham 8700 that gives you <strong>17 clicks of high-speed compression</strong>, <strong>22 clicks of low-speed compression</strong> and <strong>80 clicks of rebound</strong>.</p>
        <p>That is a great deal of adjustment — and it is only an advantage in the hands of someone with the process to use it. Used against chassis behaviour you can identify, measure and correlate to logged data, it is a precision development tool. Without that process, three independent adjusters simply offer more ways to move away from a setting that was already right. We specify, set and support these kits so the adjustment range works for you rather than against you.</p>
      </div>

      <div class="content-block">
        <h2>Who the 8700 is <span class="text-green">For</span></h2>
        <p>This is the kit for the genuine Caterham race programme — data-led development, an engineer in the loop, conditions that vary meaningfully between events, and a budget that reflects a serious long-term commitment to <a href="/track-day-suspension">circuit</a> and <a href="/hillclimb-suspension">hillclimb</a> competition.</p>
        <p>For most Caterhams this is more damper than the application justifies, and we will say so plainly. If you want strong adjustability without stepping to a full three-way remote-canister programme, the <a href="/caterham/penske-7500-coda">7500 CODA</a> or a <a href="/caterham/nitron-ntr-r3">Nitron NTR R3</a> will serve you better and cost considerably less. Our honest view on where Penske does and doesn't make sense is on the <a href="/penske-racing-shocks">Penske Racing Shocks</a> page.</p>
      </div>

      <!-- Included / Options -->
      <div class="included-grid">
        <div class="included-col">
          <h3>What's Included</h3>
          <ul class="kit-list">
            <li>Four-corner Penske 8700 3-way triple-adjustable coilover kit with remote canisters</li>
            <li>Eibach springs</li>
            <li>Mounting spacers</li>
            <li>Simon Rogers' championship-winning valving — front and rear digressive/linear</li>
            <li>Specified for your chassis, tyres and application</li>
          </ul>
        </div>
        <div class="included-col">
          <h3>Options</h3>
          <ul class="kit-list">
            <li>Hyperco springs in place of the standard Eibach springs</li>
            <li>Hydraulic spring perches for quick ride-height adjustment</li>
            <li>Torrington bearings to reduce friction during ride-height adjustment</li>
          </ul>
        </div>
      </div>

      <div class="content-block">
        <h2>Caterham <span class="text-green">Fitment</span></h2>
        <p>This kit is specified for the Caterham Seven across the S3, SV and CSR chassis. The price is the same for each — the specification work behind it is what adapts the kit to your particular car. If you are unsure which chassis you have, or how to get the most from three-way adjustment on your car, tell us and we will guide you.</p>
      </div>
    </div>
  </section>

  <!-- Related -->
  <section class="related-section">
    <div class="container">
      <div class="section-header">
        <span class="stripe-accent"></span>
        <h2>Related Expertise</h2>
      </div>
      <div class="related-grid">
        <a href="/caterham/penske-7500-coda" class="related-card">
          <h3>Penske 7500 CODA</h3>
          <p>Double-adjustable, no remote reservoir — strong adjustability a step below the 8700.</p>
          <span class="related-link">View the CODA →</span>
        </a>
        <a href="/caterham/penske-7500-cosa" class="related-card">
          <h3>Penske 7500 COSA</h3>
          <p>Single-adjustable — the entry point to Penske ownership for the Caterham Seven.</p>
          <span class="related-link">View the COSA →</span>
        </a>
        <a href="/penske-racing-shocks" class="related-card">
          <h3>Penske Racing Shocks</h3>
          <p>Why Penske is the benchmark in motorsport — and when it is and isn't the right answer.</p>
          <span class="related-link">Penske →</span>
        </a>
        <a href="/caterham/nitron-ntr-r3" class="related-card">
          <h3>Nitron NTR R3 40mm</h3>
          <p>Independent compression and rebound from Nitron — strong value for many Caterham programmes.</p>
          <span class="related-link">View the R3 →</span>
        </a>
        <a href="/caterham/suspension" class="related-card">
          <h3>Caterham Suspension Kits</h3>
          <p>The full range of Caterham coilover kits — Nitron and Penske — in one place.</p>
          <span class="related-link">All Kits →</span>
        </a>
        <a href="/hillclimb-suspension" class="related-card">
          <h3>Hillclimb Suspension</h3>
          <p>What sprint and hillclimb use demands, and why adjustability only helps with a process.</p>
          <span class="related-link">Hillclimb →</span>
        </a>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="cta-section">
    <div class="container">
      <div class="cta-content">
        <h2>Specify Your 8700 3-Way Kit</h2>
        <p>Tell us about your Caterham, your race programme and how you develop the car. We will specify an 8700 kit built on proven valving and support you in using its adjustment purposefully — and tell you honestly if something below it suits you better.</p>
        <a href="/contact" class="btn btn-primary">Start Your Specification</a>
      </div>
    </div>
  </section>

</Layout>

<style>
  /* Page Hero */
  .page-hero {
    padding: calc(80px + var(--space-xl)) 0 var(--space-lg);
    background: var(--tftr-darker);
    border-bottom: 1px solid rgba(92, 184, 92, 0.2);
  }

  .hero-subtitle {
    font-size: 1.25rem;
    color: var(--tftr-grey-light);
    max-width: 65ch;
    margin-top: var(--space-sm);
    line-height: 1.7;
  }

  .hero-intro {
    display: flex;
    align-items: stretch;
    gap: var(--space-md);
    margin-top: var(--space-md);
  }

  .hero-intro .hero-subtitle {
    margin-top: 0;
  }

  .brand-logo-chip {
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--tftr-white);
    padding: 0.6rem 1rem;
    border-radius: 4px;
    flex-shrink: 0;
  }

  .brand-logo {
    height: 100%;
    width: auto;
    max-height: 96px;
    display: block;
  }

  @media (max-width: 600px) {
    .hero-intro {
      flex-direction: column;
      align-items: flex-start;
    }

    .brand-logo {
      height: 44px;
    }
  }

  /* Summary / Price */
  .kit-summary-section {
    background: var(--tftr-black);
    padding: var(--space-lg) 0;
  }

  .kit-summary {
    display: grid;
    grid-template-columns: auto 1fr auto;
    gap: var(--space-lg);
    align-items: center;
    background: var(--tftr-darker);
    border: 1px solid rgba(92, 184, 92, 0.2);
    border-left: 3px solid var(--tftr-green);
    padding: var(--space-md);
  }

  .kit-price {
    display: flex;
    flex-direction: column;
    line-height: 1.1;
  }

  .price-label {
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--tftr-grey);
  }

  .price-figure {
    font-family: var(--font-display);
    font-size: 3rem;
    color: var(--tftr-green);
    letter-spacing: 0.03em;
  }

  .price-note {
    font-size: 0.8rem;
    color: var(--tftr-grey);
  }

  .kit-specs {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--space-sm);
  }

  .spec {
    display: flex;
    flex-direction: column;
  }

  .spec-label {
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--tftr-grey);
  }

  .spec-value {
    font-family: var(--font-heading);
    font-size: 1.05rem;
    color: var(--tftr-white);
  }

  /* Content */
  .kit-content {
    background: var(--tftr-black);
  }

  .content-block {
    max-width: 800px;
    margin-bottom: var(--space-lg);
  }

  .content-block h2 {
    margin-bottom: var(--space-md);
  }

  .content-block p {
    color: var(--tftr-grey-light);
    font-size: 1.05rem;
    line-height: 1.8;
    margin-bottom: var(--space-sm);
  }

  .included-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-md);
    margin-bottom: var(--space-lg);
  }

  .included-col {
    background: var(--tftr-darker);
    padding: var(--space-md);
    border: 1px solid rgba(255, 255, 255, 0.05);
    border-top: 2px solid var(--tftr-green);
  }

  .included-col h3 {
    font-size: 1.1rem;
    color: var(--tftr-green);
    margin-bottom: var(--space-sm);
  }

  .kit-list {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .kit-list li {
    position: relative;
    padding-left: 1.25rem;
    color: var(--tftr-grey-light);
    font-size: 0.95rem;
    line-height: 1.5;
  }

  .kit-list li::before {
    content: '→';
    position: absolute;
    left: 0;
    color: var(--tftr-green);
  }

  /* Related */
  .related-section {
    background: var(--tftr-darker);
  }

  .section-header {
    margin-bottom: var(--space-lg);
  }

  .related-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-md);
  }

  .related-card {
    background: var(--tftr-dark);
    padding: var(--space-md);
    border: 1px solid rgba(255, 255, 255, 0.05);
    transition: all 0.3s ease;
    display: flex;
    flex-direction: column;
  }

  .related-card:hover {
    border-color: rgba(92, 184, 92, 0.3);
    transform: translateY(-4px);
  }

  .related-card h3 {
    font-size: 1.25rem;
    margin-bottom: var(--space-sm);
    color: var(--tftr-white);
  }

  .related-card p {
    color: var(--tftr-grey-light);
    font-size: 0.95rem;
    line-height: 1.6;
    flex-grow: 1;
    margin-bottom: var(--space-sm);
  }

  .related-link {
    font-family: var(--font-heading);
    font-size: 0.85rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--tftr-green);
    margin-top: auto;
  }

  /* CTA */
  .cta-section {
    background: linear-gradient(135deg, var(--tftr-green-dark), var(--tftr-green));
    text-align: center;
  }

  .cta-content h2 {
    color: var(--tftr-black);
  }

  .cta-content p {
    color: rgba(0, 0, 0, 0.7);
    font-size: 1.25rem;
    margin: var(--space-sm) auto var(--space-md);
    max-width: 55ch;
  }

  .cta-content .btn-primary {
    background: var(--tftr-black);
    color: var(--tftr-white);
  }

  .cta-content .btn-primary:hover {
    background: var(--tftr-darker);
  }

  /* Responsive */
  @media (max-width: 900px) {
    .kit-summary {
      grid-template-columns: 1fr;
      gap: var(--space-md);
    }

    .kit-specs {
      grid-template-columns: repeat(2, 1fr);
    }

    .related-grid {
      grid-template-columns: 1fr;
    }
  }

  /* Product Showcase */
  .showcase-grid {
    display: grid;
    grid-template-columns: 0.85fr 1fr;
    gap: var(--space-xl);
    align-items: center;
    margin-bottom: var(--space-lg);
  }

  .showcase-image {
    background: var(--tftr-white);
    border-radius: 6px;
    padding: var(--space-md);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .showcase-image img {
    width: 100%;
    height: auto;
    max-height: 460px;
    object-fit: contain;
    display: block;
  }

  .showcase-text {
    margin-bottom: 0 !important;
  }

  @media (max-width: 900px) {
    .showcase-grid {
      grid-template-columns: 1fr;
      gap: var(--space-md);
    }
  }
</style>