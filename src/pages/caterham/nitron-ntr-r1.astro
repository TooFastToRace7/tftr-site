---
import Layout from '../../layouts/Layout.astro';

const structuredData = {
  "@context": "https://schema.org",
  "@type": "Product",
  "name": "Caterham Nitron NTR R1 40mm Suspension Kit",
  "description": "Nitron NTR R1 40mm coilover suspension kit for the Caterham Seven — S3, SV and CSR chassis. Single-adjustable dampers specified for your car, tyres and application. Supplied with Nitron springs and mounting spacers.",
  "brand": {
    "@type": "Brand",
    "name": "Nitron Racing Systems"
  },
  "category": "Coilover Suspension Kit",
  "image": "https://toofasttorace.com/images/Nitron.png",
  "url": "https://toofasttorace.com/caterham/nitron-ntr-r1",
  "offers": {
    "@type": "Offer",
    "url": "https://toofasttorace.com/caterham/nitron-ntr-r1",
    "priceCurrency": "GBP",
    "price": "1579.00",
    "availability": "https://schema.org/InStock",
    "seller": {
      "@type": "Organization",
      "name": "Too Fast To Race"
    }
  }
};
---

<Layout title="Caterham Nitron NTR R1 40mm Suspension Kit | S3 SV CSR | Too Fast To Race" description="Nitron NTR R1 40mm coilover suspension kit for the Caterham Seven — S3, SV and CSR. Single-adjustable, specified for your car. From £1,579 +VAT. Nitron springs and mounting spacers included. Bespoke specification from Too Fast To Race.">
  <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />

  <!-- Hero -->
  <section class="page-hero">
    <div class="container">
      <span class="stripe-accent"></span>
      <h1>Caterham Nitron <span class="text-green">NTR R1 40mm</span></h1>
      <p class="hero-subtitle">A correctly specified Nitron NTR R1 is the right answer for the overwhelming majority of fast road and track day Caterham Sevens. Single-adjustable, beautifully made, and specified around your car — not sold off a shelf.</p>
      <img src="/images/Nitron.png" alt="Nitron NTR R1 suspension for Caterham — Nitron Racing Systems" class="brand-logo" width="200" height="80" />
    </div>
  </section>

  <!-- Summary / Price -->
  <section class="kit-summary-section">
    <div class="container">
      <div class="kit-summary">
        <div class="kit-price">
          <span class="price-label">From</span>
          <span class="price-figure">£1,579</span>
          <span class="price-note">+ VAT &amp; shipping</span>
        </div>
        <div class="kit-specs">
          <div class="spec">
            <span class="spec-label">Damper</span>
            <span class="spec-value">Nitron NTR R1 40mm</span>
          </div>
          <div class="spec">
            <span class="spec-label">Adjustment</span>
            <span class="spec-value">Single-Adjustable</span>
          </div>
          <div class="spec">
            <span class="spec-label">Springs</span>
            <span class="spec-value">Nitron (Eibach/Hyperco optional)</span>
          </div>
          <div class="spec">
            <span class="spec-label">Chassis</span>
            <span class="spec-value">S3 · SV · CSR</span>
          </div>
        </div>
        <a href="/contact" class="btn btn-primary">Enquire About This Kit</a>
      </div>
    </div>
  </section>

  <!-- What It Is -->
  <section class="kit-content">
    <div class="container">
      <div class="content-block">
        <h2>Specified, Not Just <span class="text-green">Supplied</span></h2>
        <p>The Nitron NTR R1 is a single-adjustable coilover damper — one adjuster controls compression and rebound damping together, fine-tuning the car around a base that has already been calibrated for the application. On a Caterham Seven that single adjuster is not a compromise; it is exactly what the overwhelming majority of road and track drivers actually need.</p>
        <p>What determines how your Caterham behaves is not the number of adjusters. It is whether the spring rates and damping have been specified for your actual car, your tyres and the way you use it. That is the work we do on every NTR R1 kit — a specification project rather than a box-shifting exercise. A correctly specified R1 will comprehensively out-drive a generically set-up car with more adjustment.</p>
      </div>

      <div class="content-block">
        <h2>Who the R1 is <span class="text-green">For</span></h2>
        <p>This is the kit for <a href="/fast-road-suspension">fast road</a> Caterhams, <a href="/track-day-suspension">track day</a> cars, road-and-track compromise builds and <a href="/nurburgring-suspension">Nürburgring</a> use — anywhere you want a composed, communicative, genuinely fast car that is set correctly once and used with confidence.</p>
        <p>If you are running a dedicated, data-led race programme and adjusting between events with intent, the separately adjustable <a href="/caterham/nitron-ntr-r3">NTR R3</a> may be the better tool. We explain exactly where that line sits in <a href="/nitron-r1-vs-r3">Nitron R1 vs R3</a> — and we will give you an honest answer for your car.</p>
      </div>

      <!-- Included / Options -->
      <div class="included-grid">
        <div class="included-col">
          <h3>What's Included</h3>
          <ul class="kit-list">
            <li>Four-corner Nitron NTR R1 40mm coilover kit</li>
            <li>Nitron springs</li>
            <li>Mounting spacers</li>
            <li>Specified for your chassis, tyres and application</li>
          </ul>
        </div>
        <div class="included-col">
          <h3>Options</h3>
          <ul class="kit-list">
            <li>Eibach or Hyperco springs in place of the standard Nitron springs</li>
            <li>Hydraulic spring perches for quick ride-height adjustment</li>
            <li>Torrington bearings to reduce friction during ride-height adjustment</li>
          </ul>
        </div>
      </div>

      <div class="content-block">
        <h2>Caterham <span class="text-green">Fitment</span></h2>
        <p>This kit is specified for the Caterham Seven across the S3, SV and CSR chassis. The price is the same for each — the specification work behind it is what adapts the kit to your particular car. If you are unsure which chassis you have or how your car is used, tell us and we will guide you.</p>
      </div>
    </div>
  </section>

  <!-- Related -->
  <section class="related-section">
    <div class="container">
      <div class="section-header">
        <span class="stripe-accent"></span>
        <h2>Related Expertise</h2>
      </div>
      <div class="related-grid">
        <a href="/caterham/nitron-ntr-r3" class="related-card">
          <h3>Nitron NTR R3 40mm</h3>
          <p>Separately adjustable compression and rebound — for data-led, actively developed Caterham programmes.</p>
          <span class="related-link">View the R3 →</span>
        </a>
        <a href="/nitron-r1-vs-r3" class="related-card">
          <h3>R1 vs R3 Explained</h3>
          <p>Why the R1 is almost always the right answer — and the specific case where the R3 earns its place.</p>
          <span class="related-link">R1 vs R3 →</span>
        </a>
        <a href="/nitron-suspension" class="related-card">
          <h3>Nitron Suspension</h3>
          <p>The full Nitron range and how we approach specification for each application.</p>
          <span class="related-link">Nitron Systems →</span>
        </a>
        <a href="/caterham/suspension" class="related-card">
          <h3>Caterham Suspension Kits</h3>
          <p>The full range of Caterham coilover kits — Nitron and Penske — in one place.</p>
          <span class="related-link">All Kits →</span>
        </a>
        <a href="/track-day-suspension" class="related-card">
          <h3>Track Day Suspension</h3>
          <p>What track day use actually demands, and why balance matters more than stiffness.</p>
          <span class="related-link">Track Day →</span>
        </a>
        <a href="/caterham" class="related-card">
          <h3>Caterham Specialist</h3>
          <p>Builds, conversions, setup and development from over 30 years with the Seven.</p>
          <span class="related-link">Caterham →</span>
        </a>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="cta-section">
    <div class="container">
      <div class="cta-content">
        <h2>Specify Your R1 Kit</h2>
        <p>Tell us about your Caterham, your tyres and how you use the car. We will specify an NTR R1 kit that is right from the first drive — and give you an honest answer if something else suits you better.</p>
        <a href="/contact" class="btn btn-primary">Start Your Specification</a>
      </div>
    </div>
  </section>

</Layout>

<style>
  /* Page Hero */
  .page-hero {
    padding: calc(80px + var(--space-xl)) 0 var(--space-lg);
    background: var(--tftr-darker);
    border-bottom: 1px solid rgba(92, 184, 92, 0.2);
  }

  .hero-subtitle {
    font-size: 1.25rem;
    color: var(--tftr-grey-light);
    max-width: 65ch;
    margin-top: var(--space-sm);
    line-height: 1.7;
  }

  .brand-logo {
    height: 60px;
    width: auto;
    margin-top: var(--space-md);
    opacity: 0.9;
  }

  /* Summary / Price */
  .kit-summary-section {
    background: var(--tftr-black);
    padding: var(--space-lg) 0;
  }

  .kit-summary {
    display: grid;
    grid-template-columns: auto 1fr auto;
    gap: var(--space-lg);
    align-items: center;
    background: var(--tftr-darker);
    border: 1px solid rgba(92, 184, 92, 0.2);
    border-left: 3px solid var(--tftr-green);
    padding: var(--space-md);
  }

  .kit-price {
    display: flex;
    flex-direction: column;
    line-height: 1.1;
  }

  .price-label {
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--tftr-grey);
  }

  .price-figure {
    font-family: var(--font-display);
    font-size: 3rem;
    color: var(--tftr-green);
    letter-spacing: 0.03em;
  }

  .price-note {
    font-size: 0.8rem;
    color: var(--tftr-grey);
  }

  .kit-specs {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--space-sm);
  }

  .spec {
    display: flex;
    flex-direction: column;
  }

  .spec-label {
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--tftr-grey);
  }

  .spec-value {
    font-family: var(--font-heading);
    font-size: 1.05rem;
    color: var(--tftr-white);
  }

  /* Content */
  .kit-content {
    background: var(--tftr-black);
  }

  .content-block {
    max-width: 800px;
    margin-bottom: var(--space-lg);
  }

  .content-block h2 {
    margin-bottom: var(--space-md);
  }

  .content-block p {
    color: var(--tftr-grey-light);
    font-size: 1.05rem;
    line-height: 1.8;
    margin-bottom: var(--space-sm);
  }

  .included-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-md);
    margin-bottom: var(--space-lg);
  }

  .included-col {
    background: var(--tftr-darker);
    padding: var(--space-md);
    border: 1px solid rgba(255, 255, 255, 0.05);
    border-top: 2px solid var(--tftr-green);
  }

  .included-col h3 {
    font-size: 1.1rem;
    color: var(--tftr-green);
    margin-bottom: var(--space-sm);
  }

  .kit-list {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .kit-list li {
    position: relative;
    padding-left: 1.25rem;
    color: var(--tftr-grey-light);
    font-size: 0.95rem;
    line-height: 1.5;
  }

  .kit-list li::before {
    content: '→';
    position: absolute;
    left: 0;
    color: var(--tftr-green);
  }

  /* Related */
  .related-section {
    background: var(--tftr-darker);
  }

  .section-header {
    margin-bottom: var(--space-lg);
  }

  .related-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-md);
  }

  .related-card {
    background: var(--tftr-dark);
    padding: var(--space-md);
    border: 1px solid rgba(255, 255, 255, 0.05);
    transition: all 0.3s ease;
    display: flex;
    flex-direction: column;
  }

  .related-card:hover {
    border-color: rgba(92, 184, 92, 0.3);
    transform: translateY(-4px);
  }

  .related-card h3 {
    font-size: 1.25rem;
    margin-bottom: var(--space-sm);
    color: var(--tftr-white);
  }

  .related-card p {
    color: var(--tftr-grey-light);
    font-size: 0.95rem;
    line-height: 1.6;
    flex-grow: 1;
    margin-bottom: var(--space-sm);
  }

  .related-link {
    font-family: var(--font-heading);
    font-size: 0.85rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--tftr-green);
    margin-top: auto;
  }

  /* CTA */
  .cta-section {
    background: linear-gradient(135deg, var(--tftr-green-dark), var(--tftr-green));
    text-align: center;
  }

  .cta-content h2 {
    color: var(--tftr-black);
  }

  .cta-content p {
    color: rgba(0, 0, 0, 0.7);
    font-size: 1.25rem;
    margin: var(--space-sm) auto var(--space-md);
    max-width: 55ch;
  }

  .cta-content .btn-primary {
    background: var(--tftr-black);
    color: var(--tftr-white);
  }

  .cta-content .btn-primary:hover {
    background: var(--tftr-darker);
  }

  /* Responsive */
  @media (max-width: 900px) {
    .kit-summary {
      grid-template-columns: 1fr;
      gap: var(--space-md);
    }

    .kit-specs {
      grid-template-columns: repeat(2, 1fr);
    }

    .related-grid {
      grid-template-columns: 1fr;
    }
  }
</style>