    background: var(--tftr-black);
    padding: var(--space-lg) 0;
  }

  .intro-content {
    max-width: 800px;
  }

  .intro-content h2 {
    margin-bottom: var(--space-md);
  }

  .intro-content p {
    color: var(--tftr-grey-light);
    font-size: 1.1rem;
    line-height: 1.8;
    margin-bottom: var(--space-sm);
  }

  /* How Section */
  .how-section {
    background: var(--tftr-darker);
  }

