    color: var(--tftr-grey-light);
    margin-top: var(--space-xs);
    font-size: 1.1rem;
  }

  .how-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-md);
  }

  .how-card {
    background: var(--tftr-dark);
    padding: var(--space-md);
    border: 1px solid rgba(255, 255, 255, 0.05);
  }

  .how-card h3 {
    font-size: 1.2rem;
    color: var(--tftr-green);
    margin-bottom: var(--space-sm);
  }

  .how-card p {
    color: var(--tftr-grey-light);
    font-size: 0.95rem;
    line-height: 1.7;
    margin-bottom: var(--space-sm);
  }

  /* Variants */
  .variants-section {
    background: var(--tftr-black);
  }

  .variants-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-md);
  }

  .variant-card {
    background: var(--tftr-darker);
    padding: var(--space-md);
    border: 1px solid rgba(255, 255, 255, 0.05);
  }

  .variant-card.featured {
    border-color: rgba(92, 184, 92, 0.3);
  }

